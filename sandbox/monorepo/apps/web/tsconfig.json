{
  "extends": "@monorepo/config-typescript/react.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@icons/*": [
        "./src/assets/icons/*"
      ],
      "@images/*": [
        "./src/assets/images/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
